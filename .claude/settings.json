{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(.venv/bin/python -m pytest:*)"
    ],
    "ask": [
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/hooks/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production*)",
      "Read(**/.env.staging*)",
      "Read(**/.env.test*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(~/claude-settings-backup/**)",
      "Read(./data/**)",
      "Read(./.claude/settings.local.json)",
      "Read(**/*.db)",
      "Read(**/*.sqlite*)",
      "Read(**/*.xlsx)",
      "Read(~/.config/**/clients.db)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'echo \"$CLAUDE_TOOL_INPUT_FILE_PATH\" | grep -q \"^src/\" && cd /home/tmotoki/pjt/life-event-simulator && python -m pytest tests/ -q --tb=short 2>&1 || true'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'echo \"$CLAUDE_TOOL_INPUT_FILE_PATH\" | grep -q \"^src/domain/\" && grep -q \"TODO: FPに確認\" /home/tmotoki/pjt/life-event-simulator/docs/spec/01_requirements.md 2>/dev/null && echo \"警告: docs/spec/01_requirements.md に FP未確認事項が残っています。/fp-check で確認してから実装を進めてください。\" || true'"
          }
        ]
      }
    ]
  }
}
